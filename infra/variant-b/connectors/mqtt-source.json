{
  "connector.class": "io.lenses.streamreactor.connect.mqtt.source.MqttSourceConnector",
  "tasks.max": "1",
  "connect.mqtt.hosts": "tcp://mosquitto:1883",
  "connect.mqtt.kcql": "INSERT INTO slope-data SELECT * FROM `slope/+/+/data` WITHCONVERTER=`io.lenses.streamreactor.connect.converters.source.BytesConverter`",
  "connect.mqtt.service.quality": "1",
  "connect.mqtt.client.id": "magris-connect-mqtt",
  "connect.mqtt.clean": "true",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter"
}
