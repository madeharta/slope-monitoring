#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import os
import pathlib
import subprocess
import sys
import tempfile
import re
from urllib.parse import quote

ROOT = pathlib.Path(os.environ.get("MAGRIS_PPK_QA_RELEASE", "/opt/landslidemon/releases/b13-e4320a8"))
CACHE = pathlib.Path("/var/cache/magris-ppk-qa")
SECRETS = pathlib.Path("/etc/landslidemon/secrets")
IMAGE = os.environ.get("MAGRIS_PPK_QA_IMAGE", "landslidemon-api:91ad329")
NETWORK = "landslidemon_db_internal"

class ContainerExecutionError(RuntimeError):
    """Retain safe diagnostics, never stdout/stderr or credentials."""
    def __init__(self, exit_code):
        self.exit_code = exit_code
        super().__init__("container execution failed")


def diagnostic(stage, exc, job=None):
    record = {"stage": stage, "error_type": type(exc).__name__}
    if isinstance(exc, ContainerExecutionError):
        record["exit_code"] = exc.exit_code
    if isinstance(exc, subprocess.TimeoutExpired):
        record["timeout_s"] = exc.timeout
    # Only fixed, code-owned error phrases are safe to disclose.
    allowed = {"unexpected scheduler coverage", "scheduler returned unexpected result",
               "scheduler container failed", "unexpected scheduler failure",
               "backlog discovery failed", "unexpected NAV status"}
    if isinstance(exc, RuntimeError) and str(exc) in allowed:
        record["reason_code"] = str(exc).upper().replace(" ", "_")
    if job is not None:
        record.update({"rover": job.get("rover"), "window": job.get("since")})
    print("QA_STAGE_FAILED:", json.dumps(record), flush=True)


def nav_status(output):
    """Accept exactly one terminal status, ignoring innocuous progress lines."""
    statuses = [line.strip() for line in output.splitlines()
                if line.strip().startswith(("NAV_READY", "NAV_WAITING"))]
    if len(statuses) != 1:
        raise RuntimeError("invalid NAV status count")
    status = statuses[0]
    if status == "NAV_WAITING":
        return status
    parts = status.split()
    if len(parts) != 3 or parts[0] != "NAV_READY" or not parts[1].isdigit() \
            or int(parts[1]) <= 0 or not re.fullmatch(r"[0-9a-f]{16}", parts[2]):
        raise RuntimeError("invalid NAV_READY fields")
    return status


def docker(args, timeout):
    result = subprocess.run(
        ["docker", *args],
        capture_output=True,
        text=True,
        timeout=timeout,
    )

    if result.returncode:
        # Avoid printing arbitrary stderr containing connection details.
        print("CONTAINER_FAILED: exit", result.returncode, flush=True)
        raise ContainerExecutionError(result.returncode)

    return result.stdout

def mounts():
    return [
        "--mount", f"type=bind,src={ROOT},dst=/workspace,readonly",
        "--mount", f"type=bind,src={CACHE},dst=/nav",
        "--workdir", "/workspace",
        "--env", "PYTHONPATH=/workspace",
        "--entrypoint", "python",
    ]

# The preserved historical state is not scanned under the recent-only policy.
STATE = CACHE / "b19_backlog_state.json"
START = dt.datetime(2026, 10, 30, 0, tzinfo=dt.timezone.utc)
# Explicit policy: recent QA only; older windows retained in state/database, never executed.
ROVERS = {"ROVER-B1-01", "ROVER-B1-02"}
MAX_JOBS = 3
RECENT_JOBS = 2  # Max ready/recent QA jobs per cycle.
NAV_RETRY_INTERVAL = dt.timedelta(minutes=15)
RECENT_LOOKBACK_HOURS = 24


def utc_hour(value):
    parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None or parsed.utcoffset() != dt.timedelta(0):
        raise ValueError("UTC timestamp required")
    if parsed.minute or parsed.second or parsed.microsecond:
        raise ValueError("whole UTC hour required")
    return parsed


def read_state():
    if not STATE.exists():
        return {"cursor": START.isoformat(), "cooldowns": {}, "nav_pending": {}}
    if STATE.stat().st_size > 128 * 1024:
        raise ValueError("state too large")
    data = json.loads(STATE.read_text())
    if not isinstance(data, dict) or not isinstance(data.get("cooldowns"), dict):
        raise ValueError("invalid backlog state")
    utc_hour(data["cursor"])
    pending = data.setdefault("nav_pending", {})
    if not isinstance(pending, dict) or len(pending) > 1000:
        raise ValueError("invalid NAV queue")
    for key, entry in pending.items():
        if not isinstance(key, str) or not isinstance(entry, dict):
            raise ValueError("invalid NAV queue entry")
        if entry.get("rover") not in ROVERS:
            raise ValueError("invalid NAV rover")
        since = utc_hour(entry["since"])
        if key != entry["rover"] + "|" + entry["since"]:
            raise ValueError("NAV queue key mismatch")
        if not isinstance(entry.get("retry_at"), str):
            raise ValueError("invalid NAV retry timestamp")
        if entry.get("ready", False) not in (True, False):
            raise ValueError("invalid NAV ready flag")
        retry_at = dt.datetime.fromisoformat(entry["retry_at"])
        if retry_at.utcoffset() != dt.timedelta(0):
            raise ValueError("invalid NAV retry timezone")
    return data


def write_state(data):
    CACHE.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".b19-state-", dir=CACHE)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, sort_keys=True)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(name, 0o600)
        os.replace(name, STATE)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def discovery_bounds(state, now):
    cutoff = (now - dt.timedelta(minutes=20)).replace(minute=0, second=0, microsecond=0)
    cursor = utc_hour(state["cursor"])
    if cursor < START or cursor >= cutoff:
        cursor = START
    finish = min(cursor + dt.timedelta(days=7), cutoff)
    if finish <= cursor:
        return None
    return cursor, finish


def load_jobs(output):
    data = json.loads(output.strip())
    jobs = data.get("selected")
    if not isinstance(jobs, list) or len(jobs) > MAX_JOBS:
        raise ValueError("invalid discovery result")
    seen = set()
    for job in jobs:
        if not isinstance(job, dict) or job.get("rover") not in ROVERS:
            raise ValueError("invalid rover")
        start, end = utc_hour(job["since"]), utc_hour(job["until"])
        if end - start != dt.timedelta(hours=1):
            raise ValueError("invalid job duration")
        key = (job["rover"], start)
        if key in seen:
            raise ValueError("duplicate discovery job")
        seen.add(key)
    return jobs


def parse_nav_output(output):
    """Extract a single terminal NAV status; preserve validated provenance."""
    statuses = []
    sources = []
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("NAV_SOURCE:"):
            try:
                source = json.loads(line.split(":", 1)[1].strip())
            except (ValueError, TypeError) as exc:
                raise RuntimeError("invalid NAV_SOURCE metadata") from exc
            if not isinstance(source, dict) or not all(
                isinstance(source.get(k), str) and source[k]
                for k in ("product", "source_url", "sha256")
            ):
                raise RuntimeError("invalid NAV_SOURCE fields")
            sources.append(source)
        elif line == "NAV_WAITING" or line.startswith("NAV_READY "):
            statuses.append(line)
        else:
            raise RuntimeError("unexpected NAV stdout record")
    if len(statuses) != 1 or len(sources) > 1:
        raise RuntimeError("invalid NAV stdout coverage")
    status = statuses[0]
    if status.startswith("NAV_READY "):
        fields = status.split()
        if len(fields) != 3 or not fields[1].isdigit() or len(fields[2]) != 16:
            raise RuntimeError("invalid NAV_READY status")
    elif sources:
        raise RuntimeError("NAV_SOURCE without NAV_READY")
    for source in sources:
        print("NAV_SOURCE:", json.dumps(source, sort_keys=True), flush=True)
    return status


def prepare_nav(job):
    # NAV downloads occur only for selected historical windows; no manual files.
    code = """
import datetime as dt
import sys
from pathlib import Path
from scripts.ppk_qa_scheduler import nav_for
start = dt.datetime.fromisoformat(sys.argv[1])
end = start + dt.timedelta(hours=1)
try:
    path, count, digest = nav_for(start, end, Path('/nav'), True)
    print('NAV_READY', count, digest[:16])
except (RuntimeError, ValueError, FileNotFoundError) as exc:
    if 'WAITING_NAV' not in str(exc):
        raise
    print('NAV_WAITING')
"""
    output = docker(["run", "--rm", "--network", "bridge", *mounts(),
                     IMAGE, "-c", code, job["since"]], timeout=180)
    return parse_nav_output(output)


def record_cooldown(state, job, result, now):
    key = job["rover"] + "|" + job["since"]
    if result == "WAITING_NAV":
        state["cooldowns"][key] = (now + NAV_RETRY_INTERVAL).isoformat()
        state.setdefault("nav_pending", {})[key] = {
            "rover": job["rover"], "since": job["since"],
            "retry_at": (now + NAV_RETRY_INTERVAL).isoformat(),
        }
    else:
        state["cooldowns"].pop(key, None)
        state.setdefault("nav_pending", {}).pop(key, None)
        if result == "WAITING_INPUT":
            state["cooldowns"][key] = (now + dt.timedelta(hours=6)).isoformat()
    # Bound state size, removing elapsed entries.
    state["cooldowns"] = {
        key: val for key, val in state["cooldowns"].items()
        if dt.datetime.fromisoformat(val) > now
    }

def due_nav_jobs(state, now):
    """Newest due NAV windows first; no discovery or DB access here."""
    eligible = []
    for entry in state.get("nav_pending", {}).values():
        if entry.get("ready", False):
            continue  # Ready windows belong to the hourly QA processor.
        since = utc_hour(entry["since"])
        if since < START:
            continue
        if dt.datetime.fromisoformat(entry["retry_at"]) <= now:
            eligible.append({"rover": entry["rover"],
                             "since": entry["since"],
                             "until": (since + dt.timedelta(hours=1)).isoformat()})
    return sorted(eligible, key=lambda item: (item["since"], item["rover"]), reverse=True)[:MAX_JOBS]


def ready_nav_jobs(state):
    """Validated NAV windows awaiting QA processing (newest first)."""
    eligible = []
    for entry in state.get("nav_pending", {}).values():
        if not entry.get("ready", False):
            continue
        since = utc_hour(entry["since"])
        if since < START:
            continue
        eligible.append({"rover": entry["rover"], "since": entry["since"],
                         "until": (since + dt.timedelta(hours=1)).isoformat()})
    return sorted(eligible, key=lambda item: (item["since"], item["rover"]), reverse=True)[:MAX_JOBS]


def retry_nav_only(job, state, now):
    """No database access or --apply: fetch/validate NAV and persist readiness."""
    nav = prepare_nav(job)
    key = job["rover"] + "|" + job["since"]
    if nav.startswith("NAV_WAITING"):
        record_cooldown(state, job, "WAITING_NAV", now)
        outcome = "WAITING_NAV"
    elif nav.startswith("NAV_READY"):
        state.setdefault("nav_pending", {})[key] = {
            "rover": job["rover"], "since": job["since"],
            "retry_at": now.isoformat(), "ready": True,
        }
        # Prevent discovery from selecting this window before the hourly runner.
        state["cooldowns"][key] = (now + dt.timedelta(hours=6)).isoformat()
        outcome = "NAV_READY"
    else:
        raise RuntimeError("unexpected NAV status")
    write_state(state)
    print("NAV_WINDOW:", json.dumps({**job, "result": outcome}), flush=True)
    return outcome


def handle_job(job, state, now):
    nav = prepare_nav(job)
    if nav.startswith("NAV_WAITING"):
        outcome = "WAITING_NAV"
        print("QA_WINDOW:", json.dumps({**job, "result": outcome}), flush=True)
    elif nav.startswith("NAV_READY"):
        outcome = run_scheduler(job)
    else:
        raise RuntimeError("unexpected NAV status")
    record_cooldown(state, job, outcome, now)
    write_state(state)
    return outcome


def run_scheduler(job, discovery=False, bounds=None, state=None, limit=MAX_JOBS, newest_first=False):
    with tempfile.TemporaryDirectory(
        prefix="magris-qa-", dir="/run"
    ) as tmp:
        envfile = pathlib.Path(tmp) / "worker.env"

        settings = {
            "PPK_QA_PROJECT_ROOT": "/workspace",
            "PPK_QA_FORWARD_CONFIG":
                "/workspace/config/rtklib_ppk_forward_qa.conf",
            "PPK_QA_NAV_CACHE": "/nav",
            "PPK_QA_SOURCE_DB_NAME": "slope_iot",
            "PPK_QA_WRITER_DB_NAME": "ppk_qa_biznet",
            "PPK_QA_SOURCE_DB_ROLE": "ppk_qa_source_reader",
            "PPK_QA_WRITER_DB_ROLE": "ppk_qa_writer",
            "PPK_QA_AUTO_ENABLED": "true",
            "PPK_QA_STAGING_ONLY": "true",
            "OPERATIONAL_ALARMS_ENABLED": "false",
        }

        for prefix, role, database in (
            ("SOURCE", "ppk_qa_source_reader", "slope_iot"),
            ("WRITER", "ppk_qa_writer", "ppk_qa_biznet"),
        ):
            password = (
                SECRETS / f"{role}_password"
            ).read_text().strip()

            if len(password) < 40:
                raise RuntimeError("invalid credential")

            settings[f"PPK_QA_{prefix}_DATABASE_URL"] = (
                f"postgresql://{role}:{quote(password, safe='')}"
                f"@landslidemon-db:5432/{database}"
            )

        fd = os.open(
            envfile, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600
        )
        with os.fdopen(fd, "w") as handle:
            for key, value in settings.items():
                handle.write(f"{key}={value}\n")

        if discovery:
            # Restrict state exposure to an isolated read-only bind mount.
            cooldown_file = pathlib.Path(tmp) / "cooldowns.json"
            cooldown_file.write_text(json.dumps(state["cooldowns"]))
            os.chmod(cooldown_file, 0o600)
            cmd = ["docker", "run", "--rm", "--network", NETWORK,
                   "--env-file", str(envfile),
                   "--mount", f"type=bind,src={cooldown_file},dst=/run/cooldowns.json,readonly",
                   *mounts(), IMAGE, "scripts/ppk_qa_backlog.py",
                   "--since", bounds[0].isoformat(), "--until", bounds[1].isoformat(),
                   "--limit", str(limit), "--cooldowns", "/run/cooldowns.json"]
            if newest_first:
                cmd.append("--newest-first")
            completed = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
            if completed.returncode:
                raise RuntimeError("backlog discovery failed")
            return load_jobs(completed.stdout)

        args = ["--rover", job["rover"], "--since", job["since"],
                "--until", job["until"]]
        command = ["docker", "run", "--rm", "--network", NETWORK,
                   "--env-file", str(envfile), *mounts(), IMAGE,
                   "scripts/ppk_qa_scheduler.py", "--apply", "--no-download",
                   *args, "--timeout-seconds", "600"]
        result = subprocess.run(command, capture_output=True, text=True, timeout=660)
        records = []
        for line in result.stdout.splitlines():
            try:
                value = json.loads(line)
            except ValueError:
                continue
            if isinstance(value, dict) and "window" in value:
                records.append(value)
        if len(records) != 1 or records[0].get("rover") != job["rover"]:
            raise RuntimeError("unexpected scheduler coverage")
        record = records[0]
        outcome = record.get("result")
        if outcome not in {"WAITING_NAV", "WAITING_INPUT", "PROCESSED_OR_IDEMPOTENT"}:
            # Worker stdout/stderr can contain sensitive connection details.
            # Emit ONLY fixed allowlisted status tokens and numeric exit codes.
            allowed_statuses = {"FAILED", "COMPLETED", "RUNNING", "WAITING_PAIR",
                                "INSUFFICIENT_OVERLAP", "WAITING_NAV",
                                "SKIPPED_ALREADY_COMPLETED", "NAV_READY", "SINGLE", "FLOAT", "FIX"}
            statuses = record.get("statuses")
            statuses_safe = ([x for x in statuses if isinstance(x, str) and x in allowed_statuses][:16]
                             if isinstance(statuses, list) else [])
            allowed_outcomes = {"FAILED", "NO_STATUS", "STOP"}
            print("QA_WORKER_DIAG:", json.dumps({
                "rover": job["rover"], "window": job["since"],
                "worker_result": outcome if isinstance(outcome, str) and outcome in allowed_outcomes else "UNRECOGNIZED",
                "worker_exit_code": result.returncode,
                "worker_statuses": statuses_safe,
                "status_count": len(statuses) if isinstance(statuses, list) else None,
            }), flush=True)
            raise RuntimeError("scheduler returned unexpected result")
        if result.returncode not in (0, 1):
            raise RuntimeError("scheduler container failed")
        if result.returncode == 1 and outcome != "WAITING_NAV":
            raise RuntimeError("unexpected scheduler failure")
        print("QA_WINDOW:", json.dumps({k:record[k] for k in (
              "window", "until", "rover", "result", "nav_reason", "statuses")
              if k in record}), flush=True)
        return outcome

def main(nav_retry_only=False):
    if "MAGRIS_PPK_QA_RELEASE" not in os.environ or "MAGRIS_PPK_QA_IMAGE" not in os.environ:
        raise RuntimeError("explicit Batch 19 release and image required")
    if not ROOT.is_dir() or not CACHE.is_dir():
        raise RuntimeError("release or NAV cache missing")
    now = dt.datetime.now(dt.timezone.utc)
    state = read_state()
    if nav_retry_only:
        jobs = due_nav_jobs(state, now)
        summary = {"selected": len(jobs), "waiting_nav": 0, "nav_ready": 0, "failed": 0}
        for job in jobs:
            try:
                outcome = retry_nav_only(job, state, now)
            except (Exception) as exc:
                # Never discard the job or mark NAV ready on a failed attempt.
                # Persist a bounded retry delay before attempting the next job.
                diagnostic("NAV_RETRY", exc, job)
                key = job["rover"] + "|" + job["since"]
                entry = state["nav_pending"][key]
                entry["retry_at"] = (now + NAV_RETRY_INTERVAL).isoformat()
                entry["ready"] = False
                write_state(state)
                summary["failed"] += 1
                continue
            summary[{"WAITING_NAV": "waiting_nav", "NAV_READY": "nav_ready"}[outcome]] += 1
        print("NAV_RETRY_SUMMARY:", json.dumps(summary), flush=True)
        if summary["failed"]:
            raise RuntimeError("NAV retry partial failure")
        return
    # Recent-first: inspect a bounded 24-hour horizon of closed UTC hours.
    # Historical discovery is disabled; state cursor remains unchanged.
    cutoff = (now - dt.timedelta(minutes=20)).replace(
        minute=0, second=0, microsecond=0)
    recent_bounds = (max(START, cutoff - dt.timedelta(hours=RECENT_LOOKBACK_HOURS)), cutoff)
    ready = ready_nav_jobs(state)
    summary = {"selected": 0, "waiting_nav": 0, "waiting_input": 0,
               "processed_or_idempotent": 0, "failed": 0}
    completed_keys = set()

    def process_one(job, stage, nav_ready=False):
        key = (job["rover"], job["since"])
        if key in completed_keys:
            return
        completed_keys.add(key)
        summary["selected"] += 1
        try:
            outcome = run_scheduler(job) if nav_ready else handle_job(job, state, now)
            if nav_ready:
                state.setdefault("ready_retry_after", {}).pop(
                    job["rover"] + "|" + job["since"], None)
                record_cooldown(state, job, outcome, now)
                write_state(state)
            summary[{"WAITING_NAV": "waiting_nav", "WAITING_INPUT": "waiting_input",
                     "PROCESSED_OR_IDEMPOTENT": "processed_or_idempotent"}[outcome]] += 1
        except Exception as exc:
            # Do not repeatedly fail on the same hour; do not mark it completed.
            # The cooldown is temporary and revisitable, not a deletion.
            diagnostic(stage, exc, job)
            job_key = job["rover"] + "|" + job["since"]
            state["cooldowns"][job_key] = (now + dt.timedelta(minutes=15)).isoformat()
            if nav_ready:
                state.setdefault("ready_retry_after", {})[job_key] = (
                    now + dt.timedelta(minutes=15)).isoformat()
            write_state(state)
            summary["failed"] += 1

    # Ready NAV jobs bypass discovery; respect a cooldown after a failed run.
    ready_eligible = [job for job in ready if
        dt.datetime.fromisoformat(state.get("ready_retry_after", {}).get(
            job["rover"] + "|" + job["since"], START.isoformat())) <= now]
    for job in ready_eligible[:RECENT_JOBS]:
        process_one(job, "QA_READY_PROCESS", nav_ready=True)

    remaining_recent = RECENT_JOBS - summary["selected"]
    if remaining_recent and recent_bounds[0] < recent_bounds[1]:
        try:
            recent_jobs = run_scheduler(None, discovery=True, bounds=recent_bounds,
                                        state=state, limit=remaining_recent, newest_first=True)
            print("RECENT_DISCOVERY:", json.dumps({
                "since": recent_bounds[0].isoformat(),
                "until": recent_bounds[1].isoformat(),
                "selected": len(recent_jobs)}), flush=True)
        except Exception as exc:
            diagnostic("RECENT_DISCOVERY", exc)
            recent_jobs = []
            summary["failed"] += 1
        for job in recent_jobs:
            process_one(job, "QA_RECENT_WINDOW")

    # Recent-only policy: no historical discovery/cursor advancement.
    # Historical NAV and cooldown records are deliberately left intact for audit.
    print("HISTORICAL_DISCOVERY: DISABLED_RECENT_ONLY", flush=True)
    print("SCHEDULER_SUMMARY:", json.dumps(summary), flush=True)
    if summary["failed"]:
        raise RuntimeError("one or more QA windows failed; see QA_STAGE_FAILED")
    print("SCHEDULER_ONESHOT: PASS", flush=True)

if __name__ == "__main__":
    try:
        parser = argparse.ArgumentParser(description="MAGRIS PPK QA backlog runner")
        parser.add_argument("--nav-retry-only", action="store_true",
                            help="retry previously discovered WAITING_NAV windows only")
        args = parser.parse_args()
        main(nav_retry_only=args.nav_retry_only)
    except Exception as exc:
        print("SCHEDULER_ONESHOT: FAILED", type(exc).__name__, flush=True)
        sys.exit(1)
