# COPY to /etc/magris/ppk-qa.env, mode 0600. Never commit secrets.
PPK_QA_AUTO_ENABLED=false
PPK_QA_STAGING_ONLY=true
OPERATIONAL_ALARMS_ENABLED=false
PPK_QA_DATABASE_URL=REPLACE_IN_SECRET_STORE
PPK_QA_PROJECT_ROOT=/opt/magris/current
PPK_QA_FORWARD_CONFIG=/etc/magris/forward-qa.conf
PPK_QA_NAV_CACHE=/var/cache/magris-ppk-qa
# RTKLIB binaries must be on PATH, installed/executable and separately smoke-tested.
